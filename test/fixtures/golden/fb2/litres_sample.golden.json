  "content": {
    "blocks": [
      {
        "type": "quote",
        "blocks": [
          {
            "type": "paragraph",
            "inlines": [
              {
                "type": "text",
                "text": "И жить торопится, и чувствовать спешит."
              }
            ]
          }
        ],
        "citation": [
          {
            "type": "text",
            "text": "Кн. Вяземский"
          }
        ]
      },
      {
        "type": "section",
        "title": [
          {
            "type": "text",
            "text": "Глава I"
          }
        ],
        "blocks": [
          {
            "type": "quote",
            "blocks": [
              {
                "type": "paragraph",
                "inlines": [
                  {
                    "type": "text",
                    "text": "И в голос все решили так,"
                  }
                ]
              },
              {
                "type": "paragraph",
                "inlines": [
                  {
                    "type": "text",
                    "text": "Что он опаснейший чудак."
                  }
                ]
              }
            ],
            "citation": [
              {
                "type": "text",
                "text": "Грибоедов"
              }
            ]
          },
          {
            "type": "paragraph",
            "inlines": [
              {
                "type": "text",
                "text": "«Мой дядя самых честных правил,"
              },
              {
                "type": "line_break"
              },
              {
                "type": "text",
                "text": "Когда не в шутку занемог,"
              },
              {
                "type": "line_break"
              },
              {
                "type": "text",
                "text": "Он уважать себя заставил"
              },
              {
                "type": "line_break"
              },
              {
                "type": "text",
                "text": "И лучше выдумать не мог"
              },
              {
                "type": "footnote_ref",
                "id": "note_1",
                "label": [
                  {
                    "type": "text",
                    "text": "[1]"
                  }
                ]
              },
              {
                "type": "text",
                "text": ".»"
              }
            ]
          },
          {
            "type": "poem",
            "stanzas": [
              {
                "lines": [
                  {
                    "inlines": [
                      {
                        "type": "text",
                        "text": "Так думал молодой повеса,"
                      }
                    ]
                  },
                  {
                    "inlines": [
                      {
                        "type": "text",
                        "text": "Летя в пыли на почтовых,"
                      }
                    ]
                  },
                  {
                    "inlines": [
                      {
                        "type": "text",
                        "text": "Всевышней волею Зевеса"
                      }
                    ]
                  },
                  {
                    "inlines": [
                      {
                        "type": "text",
                        "text": "Наследник всех своих родных."
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "paragraph",
            "inlines": [
              {
                "type": "text",
                "text": "Служив отлично благородно, долгами жил его отец"
              },
              {
                "type": "footnote_ref",
                "id": "note_2",
                "label": [
                  {
                    "type": "text",
                    "text": "[2]"
                  }
                ]
              },
              {
                "type": "text",
                "text": "."
              }
            ]
          }
        ]
      }
    ],
